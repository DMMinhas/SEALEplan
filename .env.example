# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. All are server-only secrets:
# never prefix them with NEXT_PUBLIC_.

# Supabase Postgres connection string – use the *transaction pooler* (port 6543)
# from Supabase → Connect → "Transaction pooler". Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Secret for the admin link: https://your-app.vercel.app/admin?token=<ADMIN_TOKEN>
# At least 16 characters, URL-safe. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Secret used to sign the admin session cookie and hash IPs for rate limiting.
# At least 32 characters. Generate with: openssl rand -hex 32
APP_SECRET=
